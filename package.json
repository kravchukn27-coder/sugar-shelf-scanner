{
  "name": "sugar-shelf-scanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean:next": "node scripts/clean-next.mjs",
    "verify": "npm run clean:next && npm run build && npm run typecheck"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
