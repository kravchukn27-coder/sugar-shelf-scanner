# `mock` makes scan endpoints deterministic and needs no external credentials.
VISION_PROVIDER=mock

# Required only when VISION_PROVIDER=gemini.
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-3.6-flash
# Optional low-cost override for the preflight gate. By default it reuses
# GEMINI_VISION_MODEL, which avoids a model-access mismatch.
# GEMINI_PREFLIGHT_MODEL=gemini-2.5-flash-lite
# Optional override for the full analyze call. By default it reuses
# GEMINI_VISION_MODEL, same as GEMINI_PREFLIGHT_MODEL above.
# GEMINI_ANALYZE_MODEL=gemini-2.5-flash-lite

# Circuit breaker primary/fallback pair (src/lib/observability/circuit-breaker.ts).
# If Gemini's live success rate degrades on GEMINI_PREFLIGHT_MODEL/GEMINI_ANALYZE_MODEL,
# traffic automatically fails over to these until it recovers. Both default to
# GEMINI_VISION_MODEL when unset, so an unconfigured deployment behaves exactly
# as if the breaker didn't exist (a single model, everywhere).
# GEMINI_PREFLIGHT_MODEL_FALLBACK=gemini-3.6-flash
# GEMINI_ANALYZE_MODEL_FALLBACK=gemini-3.6-flash
# Tuning knobs for the breaker above. All optional; defaults are tuned for
# this app's traffic volume (see the module for the exact reasoning) --
# only override them when investigating or deliberately re-tuning the
# breaker's behavior, not as a matter of routine deployment config.
# GEMINI_BREAKER_MIN_SAMPLES_PREFLIGHT=8
# GEMINI_BREAKER_MIN_SAMPLES_ANALYZE=5
# GEMINI_BREAKER_FAILURE_THRESHOLD=0.4
# GEMINI_BREAKER_COOLDOWN_MS=120000
# GEMINI_BREAKER_PROBE_INTERVAL_MS=30000
# GEMINI_BREAKER_RECOVER_STREAK=3
# GEMINI_BREAKER_MIN_TRANSITION_INTERVAL_MS=30000
# GEMINI_BREAKER_PROBE_LOCK_FLOOR_MS_PREFLIGHT=6000
# GEMINI_BREAKER_PROBE_LOCK_FLOOR_MS_ANALYZE=35000

# Set this before enabling persistence, contribution collection, or production rate limiting.
# DATABASE_URL=
# RATE_LIMIT_SECRET=

# Enables durable product analytics events for the internal dashboard. It needs
# DATABASE_URL and is independent of the browser scanner telemetry gate.
# ANALYTICS_ENABLED=false
# Server-only bearer secret for /admin/analytics. Use a durable random value of
# at least 16 characters; never prefix it with NEXT_PUBLIC_.
# ANALYTICS_ADMIN_SECRET=
# Server-only HMAC secret for browser installation IDs used in DAU/WAU/MAU.
# It must remain stable or historical unique-user counts cannot be reconciled.
# ANALYTICS_SUBJECT_SECRET=

# Optional server-only Sentry DSN for production exception stack traces. The
# SDK is disabled unless this exact variable is present; never use NEXT_PUBLIC_.
# SENTRY_DSN=
# Optional actual Google Cloud billing panel. Base64-encode the complete JSON
# key for a read-only BigQuery service account; never expose it publicly.
# GOOGLE_CLOUD_BILLING_PROJECT_ID=gen-lang-client-0349591718
# GOOGLE_CLOUD_BILLING_DATASET_ID=sugar_billing
# GOOGLE_CLOUD_BILLING_SERVICE_ACCOUNT_JSON_BASE64=

# Free product-data fallbacks. USDA key: https://fdc.nal.usda.gov/api-key-signup.html
# USDA_FDC_API_KEY=
# OPEN_FOOD_FACTS_USER_AGENT="SugarShelfScanner/0.1 (your-email@example.com)"

# Privacy-safe scanner telemetry. This one server gate applies to scanner-stage
# summaries and P0 result-funnel/result-quality events. Keep it disabled unless
# the observation window, log access, and retention approach are approved.
# SCANNER_METRICS_ENABLED=false
# Build-time browser gate for the same telemetry. Redeploy after changing it.
# NEXT_PUBLIC_SCANNER_METRICS_ENABLED=false

# Temporary server-only Gemini token-usage diagnostic. It is independent of
# scanner telemetry and does not enable browser events.
# VISION_USAGE_METRICS_ENABLED=false

# Live-camera frame quality gate (D3). Set false for a quick client rollback;
# upload analysis and recovery camera are not affected.
# NEXT_PUBLIC_FRAME_QUALITY_ENABLED=true

# --- Monetization test (paywall). Remove this whole block when the test ends. ---
# Build-time browser gate. While it is absent or false the scanner behaves
# exactly as before: no free-scan counter, no paywall, no access requests.
# NEXT_PUBLIC_PAYWALL_ENABLED=false
# Stripe Payment Link the paywall sends the buyer to. Its "after payment"
# redirect must point back at this app as /?checkout={CHECKOUT_SESSION_ID}.
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Server-only Stripe secret key used to verify one completed checkout session.
# STRIPE_SECRET_KEY=
# Server-only signing secret for POST /api/webhooks/stripe. Create it when
# registering the endpoint in Stripe; it starts with whsec_.
# STRIPE_WEBHOOK_SECRET=
# Server-only HMAC key for the buyer-email digest stored with an access pass.
# At least 16 characters. Rotating it makes existing passes unrestorable.
# ACCESS_PASS_SECRET=
