# `mock` makes scan endpoints deterministic and needs no external credentials.
VISION_PROVIDER=mock

# Required only when VISION_PROVIDER=gemini.
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-3.6-flash
# Optional low-cost override for the preflight gate. By default it reuses
# GEMINI_VISION_MODEL, which avoids a model-access mismatch.
# GEMINI_PREFLIGHT_MODEL=gemini-2.5-flash-lite

# Set this before enabling persistence, contribution collection, or production rate limiting.
# DATABASE_URL=
# RATE_LIMIT_SECRET=

# Free product-data fallbacks. USDA key: https://fdc.nal.usda.gov/api-key-signup.html
# USDA_FDC_API_KEY=
# OPEN_FOOD_FACTS_USER_AGENT="SugarShelfScanner/0.1 (your-email@example.com)"

# Privacy-safe scanner telemetry. This one server gate applies to scanner-stage
# summaries and P0 result-funnel/result-quality events. Keep it disabled unless
# the observation window, log access, and retention approach are approved.
# SCANNER_METRICS_ENABLED=false
# Build-time browser gate for the same telemetry. Redeploy after changing it.
# NEXT_PUBLIC_SCANNER_METRICS_ENABLED=false

# Temporary server-only Gemini token-usage diagnostic. It is independent of
# scanner telemetry and does not enable browser events.
# VISION_USAGE_METRICS_ENABLED=false

# Live-camera frame quality gate (D3). Set false for a quick client rollback;
# upload analysis and recovery camera are not affected.
# NEXT_PUBLIC_FRAME_QUALITY_ENABLED=true
